{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fluid Glass Material Configuration",
  "type": "object",
  "required": [
    "quality",
    "interaction",
    "cards"
  ],
  "properties": {
    "storageKey": {
      "type": "string",
      "minLength": 1,
      "default": "fluid_glass_material_config"
    },
    "quality": {
      "type": "string",
      "enum": [
        "auto",
        "high",
        "balanced",
        "eco",
        "fallback"
      ],
      "default": "auto"
    },
    "interaction": {
      "type": "boolean",
      "default": true
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "key",
          "a",
          "b",
          "c",
          "speed",
          "intensity",
          "pointer",
          "surface",
          "seed"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "eyebrow": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "unit": {
            "type": "string"
          },
          "change": {
            "type": "number"
          },
          "preset": {
            "type": "string"
          },
          "a": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "b": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "c": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "speed": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "intensity": {
            "type": "number",
            "minimum": 0.35,
            "maximum": 1.6
          },
          "pointer": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.5
          },
          "surface": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "seed": {
            "type": "number"
          },
          "chart": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}